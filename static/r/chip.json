			"content": "import Root, { chipVariants, type ChipProps, type ChipVariant, type ChipType } from \"./chip.svelte\";\n\nexport {\n\tRoot,\n\ttype ChipProps as Props,\n\t//\n\tRoot as Chip,\n\tchipVariants,\n\ttype ChipProps,\n\ttype ChipVariant,\n\ttype ChipType,\n};\n",
