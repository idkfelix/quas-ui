{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "copy-button",
	"type": "registry:ui",
	"devDependencies": [
		"@lucide/svelte@^1.28.0",
		"bits-ui@^2.16.3",
		"@internationalized/date@^3.12.0"
	],
	"registryDependencies": [
		"./button.json",
		"./use-clipboard.json"
	],
	"files": [
		{
			"content": "<script lang=\"ts\" module>\n\timport type { ButtonProps } from \"$UI$/button/index.js\";\n\timport type { WithElementRef } from \"bits-ui\";\n\timport type { HTMLButtonAttributes } from \"svelte/elements\";\n\n\texport type CopyButtonProps = WithElementRef<HTMLButtonAttributes> &\n\t\tPick<ButtonProps, \"size\" | \"variant\"> & {\n\t\t\tonCopy?: (copied: boolean | undefined) => void;\n\t\t\ttext: string;\n\t\t};\n</script>\n\n<script lang=\"ts\">\n\timport CheckIcon from \"@lucide/svelte/icons/check\";\n\timport CopyIcon from \"@lucide/svelte/icons/copy\";\n\timport XIcon from \"@lucide/svelte/icons/x\";\n\timport { mergeProps } from \"bits-ui\";\n\timport { scale } from \"svelte/transition\";\n\timport { UseClipboard } from \"$HOOKS$/use-clipboard.svelte\";\n\timport { Button } from \"$UI$/button/index.js\";\n\timport { cn } from \"$UTILS$.js\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tsize = \"icon\",\n\t\tvariant,\n\t\tonCopy,\n\t\ttext,\n\t\tchildren,\n\t\t...restProps\n\t}: CopyButtonProps = $props();\n\n\t// svelte-ignore state_referenced_locally\n\tif (size === \"icon\" && children) {\n\t\tsize = \"default\";\n\t}\n\n\tlet clipboard = new UseClipboard();\n\n\tconst merged = $derived(\n\t\tmergeProps(restProps, {\n\t\t\tonclick: async () => {\n\t\t\t\tconst copied = await clipboard.copy(text);\n\t\t\t\tonCopy?.(copied);\n\t\t\t},\n\t\t})\n\t);\n</script>\n\n<Button\n\tbind:ref\n\tclass={cn(\"flex items-center gap-2\", className)}\n\t{size}\n\t{variant}\n\t{...merged as ButtonProps}\n>\n\t{#if clipboard.copied === true}\n\t\t<div in:scale={{ duration: 500, start: 0.85 }}>\n\t\t\t<CheckIcon tabindex={-1} data-icon=\"inline-start\" />\n\t\t</div>\n\t{:else if clipboard.copied === false}\n\t\t<div in:scale={{ duration: 500, start: 0.85 }}>\n\t\t\t<XIcon tabindex={-1} data-icon=\"inline-start\" />\n\t\t</div>\n\t{:else}\n\t\t<div in:scale={{ duration: 500, start: 0.85 }}>\n\t\t\t<CopyIcon tabindex={-1} data-icon=\"inline-start\" />\n\t\t</div>\n\t{/if}\n\t{@render children?.()}\n</Button>\n",
			"type": "registry:file",
			"target": "copy-button/copy-button.svelte"
		},
		{
			"content": "import Root from \"./copy-button.svelte\";\n\nexport {\n\tRoot,\n\t//\n\tRoot as CopyButton,\n};\n",
			"type": "registry:file",
			"target": "copy-button/index.ts"
		}
	]
}