{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "copy-button",
	"type": "registry:ui",
	"devDependencies": [
		"@lucide/svelte@^1.28.0",
		"bits-ui@^2.16.3",
		"@internationalized/date@^3.12.0"
	],
	"registryDependencies": [
		"./button.json",
		"./use-clipboard.json"
	],
	"files": [
		{
			"content": "<script lang=\"ts\" module>\n\timport type { ButtonSize, ButtonVariant } from \"$UI$/button/index.js\";\n\timport type { WithElementRef } from \"bits-ui\";\n\timport type { HTMLButtonAttributes } from \"svelte/elements\";\n\n\texport type CopyButtonProps = WithElementRef<HTMLButtonAttributes> & {\n\t\tvariant?: Exclude<ButtonVariant, \"destructive\" | \"link\">;\n\t\tsize?: ButtonSize;\n\t\ttext: string;\n\t};\n</script>\n\n<script lang=\"ts\">\n\timport CheckIcon from \"@lucide/svelte/icons/check\";\n\timport CopyIcon from \"@lucide/svelte/icons/copy\";\n\timport XIcon from \"@lucide/svelte/icons/x\";\n\timport { mergeProps } from \"bits-ui\";\n\timport { scale } from \"svelte/transition\";\n\timport { UseClipboard } from \"$HOOKS$/use-clipboard.svelte\";\n\timport { buttonVariants } from \"$UI$/button/index.js\";\n\timport { cn } from \"$UTILS$.js\";\n\n\tlet {\n\t\tref = $bindable(null),\n\t\tclass: className,\n\t\tvariant = \"default\",\n\t\tsize = \"icon\",\n\t\ttext,\n\t\tchildren,\n\t\t...restProps\n\t}: CopyButtonProps = $props();\n\n\tconst clipboard = new UseClipboard();\n</script>\n\n<button\n\tbind:this={ref}\n\tdata-copy-button\n\tdata-slot=\"button\"\n\tclass={cn(buttonVariants({ variant, size }), className)}\n\t{...mergeProps(restProps, {\n\t\tonclick: () => clipboard.copy(text),\n\t})}\n>\n\t{#if clipboard.copied === true}\n\t\t<div in:scale={{ duration: 500, start: 0.85 }}>\n\t\t\t<CheckIcon tabindex={-1} />\n\t\t\t<span class=\"sr-only\">Copied</span>\n\t\t</div>\n\t{:else if clipboard.copied === false}\n\t\t<div in:scale={{ duration: 500, start: 0.85 }}>\n\t\t\t<XIcon tabindex={-1} />\n\t\t\t<span class=\"sr-only\">Failed to copy</span>\n\t\t</div>\n\t{:else}\n\t\t<div in:scale={{ duration: 500, start: 0.85 }}>\n\t\t\t<CopyIcon tabindex={-1} />\n\t\t\t<span class=\"sr-only\">Copy</span>\n\t\t</div>\n\t{/if}\n\t{@render children?.()}\n</button>\n",
			"type": "registry:file",
			"target": "copy-button/copy-button.svelte"
		},
		{
			"content": "import Root, { type CopyButtonProps } from \"./copy-button.svelte\";\n\nexport {\n\tRoot,\n\ttype CopyButtonProps as Props,\n\t//\n\tRoot as CopyButton,\n\ttype CopyButtonProps,\n};\n",
			"type": "registry:file",
			"target": "copy-button/index.ts"
		}
	]
}