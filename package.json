{
  "name": "quas-ui",
  "homepage": "https://quas.vercel.app",
  "license": "MIT NON-AI",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:idkfelix/quas-ui.git"
  },
  "scripts": {
    "dev": "concurrently -p none 'bun:dev:*'",
    "dev:app": "vite dev",
    "dev:content": "velite dev",
    "dev:registry": "tsx watch --include \"src/lib/registry/**/*\" scripts/registry.ts build",
    "build": "bun build:registry && bun build:content && bun build:app",
    "build:app": "vite build",
    "build:content": "velite",
    "build:registry": "tsx scripts/registry.ts build",
    "lint": "svelte-kit sync && svelte-check && eslint .",
    "fmt": "oxfmt"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.28.0",
    "@mdsx/rehype-custom-highlighter": "^0.0.3",
    "@shikijs/langs": "^4.4.2",
    "@shikijs/themes": "^4.4.2",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.4.1",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "mdsx": "^0.0.7",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.61.0",
    "package-manager-detector": "^1.8.0",
    "publint": "^0.3.21",
    "rehype-slug": "^6.0.0",
    "shadcn-svelte": "^1.4.2",
    "shiki": "^4.4.2",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "svelte-sonner": "^1.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "velite": "^0.4.0",
    "vite": "^8.2.1",
    "zod": "^4.4.3"
  }
}
